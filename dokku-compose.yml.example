# dokku-compose.yml
# Declarative Dokku deployment configuration

# Optional: hard minimum Dokku version for `up`
dokku:
  version: "0.38.29"

# Plugin installation
plugins:
  postgres:
    url: https://github.com/dokku/dokku-postgres.git
  redis:
    url: https://github.com/dokku/dokku-redis.git

# Authenticate host docker daemon to private registries (for `git:from-image`).
# See docs/reference/docker_auth.md.
docker_auth:
  ghcr.io:
    username: "${GHCR_USERNAME}"
    password: "${GHCR_PAT}"

# Shared Docker networks for inter-app communication
networks:
  - backend-net

# Storage entries: named host directories, mounted into apps by name.
# See docs/reference/storage.md.
volumes:
  uploads: {}                      # /var/lib/dokku/data/storage/uploads, chowned to herokuish (32767)
  reports:
    chown: 1000                    # a preset (herokuish, heroku, paketo, root), a uid, or false
    mode: "0750"                   # quoted octal
  media:
    path: /srv/media               # an existing directory; you manage its owner and mode

# Postgres and Redis service instances, keyed by service name
postgres:
  api-postgres:
    version: "17-3.5"
    image: postgis/postgis         # custom image (e.g., PostGIS)
  worker-db: {}                    # separate database for worker
redis:
  api-redis:
    version: "7.2-alpine"
  shared-cache: {}                 # shared between multiple apps

# Application definitions
apps:
  # Full example with all options
  api:
    build:
      dockerfile: docker/prod/api/Dockerfile
      app_json: docker/prod/api/app.json
      context: apps/api
      args:
        SENTRY_AUTH_TOKEN: "${SENTRY_AUTH_TOKEN}"
    domains:
      - api.example.com
    ports:
      - "https:4001:4000"
    ssl:
      certfile: certs/example.com/server.crt
      keyfile: certs/example.com/server.key
    links:
      - api-postgres
      - api-redis
      - shared-cache
    storage:
      - uploads:/app/uploads
      - entry: media
        container_dir: /app/media
        readonly: true
    nginx:
      client-max-body-size: "15m"
      proxy-buffer-size: "8k"
    env:
      APP_ENV: "${APP_ENV}"
      SECRET_KEY: "${SECRET_KEY}"
    networks:
      - backend-net

  # Worker -- shares cache with api, has its own database
  worker:
    ports:
      - "http:5001:5000"
    links:
      - worker-db
      - shared-cache
    networks:
      - backend-net
    scale:
      worker: 2

  # Web frontend -- no database
  web:
    build:
      dockerfile: docker/prod/web/Dockerfile
      context: apps/web
    domains:
      - www.example.com
    ports:
      - "https:3000:3000"
